<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.goog-assistant.seatalk-snapshot.plist
  ─────────────────────────────────────────
  Runs seatalk_snapshot.py every morning at 07:50 SGT so the Redis snapshot
  is ready before the Vercel 8am cron fires.

  Source of truth: this repo. Do NOT copy scripts elsewhere (the old
  ~/.goog-assistant/scripts and ~/.goog-assistant/use-seatalk copies drifted
  and broke both jobs in Nov 2026). Install / re-sync with:
    bash scripts/install_launchagents.sh
  which copies this plist, reloads it, and runs scripts/seatalk_doctor.py.

  Interpreter: /usr/local/bin/python3.11 — the only one with all deps
  (websocket-client, anthropic, markdown, upstash-redis).

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.goog-assistant.seatalk-snapshot.plist
    rm ~/Library/LaunchAgents/com.goog-assistant.seatalk-snapshot.plist

  Logs:
    /tmp/goog-assistant-seatalk-snapshot.log
    /tmp/goog-assistant-seatalk-snapshot.err
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.goog-assistant.seatalk-snapshot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/python3.11</string>
    <string>/Users/shuning.wang/My Projects/Working Efficiency/GooG Assistant/scripts/seatalk_snapshot.py</string>
    <string>--hours</string>
    <string>24</string>
  </array>

  <!-- Run at 07:50 SGT (pre-briefing) and again at 08:05 SGT as a fallback
       in case Chrome/SeaTalk was not yet open at 07:50.
       Both runs write to the same Redis key so the later run just refreshes it.
       The script itself retries CDP (3x, 30s apart) and Redis (4x, 15s apart)
       to handle Chrome not yet open and post-sleep DNS delays. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>   <integer>7</integer>
      <key>Minute</key> <integer>50</integer>
    </dict>
    <dict>
      <key>Hour</key>   <integer>8</integer>
      <key>Minute</key> <integer>5</integer>
    </dict>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/shuning.wang/My Projects/Working Efficiency/GooG Assistant</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>SEATALK_SKILL_ROOT</key>
    <string>/Users/shuning.wang/My Projects/Working Efficiency/use-seatalk</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/goog-assistant-seatalk-snapshot.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/goog-assistant-seatalk-snapshot.err</string>

  <!-- Retry 60s after failure -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
